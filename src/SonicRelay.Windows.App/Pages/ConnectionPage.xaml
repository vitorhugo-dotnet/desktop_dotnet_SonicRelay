<Page x:Class="SonicRelay.Windows.App.Pages.ConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:SonicRelay.Windows.App.Controls">
  <ScrollViewer><StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" Text="Connection"/>
    <TextBlock x:Name="DeviceStatusText" Text="Publisher device identity unavailable"/>
    <TextBlock x:Name="BackendText" Text="Backend not configured" TextWrapping="Wrap" Opacity="0.7"/>

    <controls:PairingCard x:Name="PairingCard"/>

    <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left"/>
    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False"/>
  </StackPanel></ScrollViewer>
</Page>
