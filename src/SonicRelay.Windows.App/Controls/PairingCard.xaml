<UserControl
    x:Class="SonicRelay.Windows.App.Controls.PairingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="16">
    <StackPanel Spacing="12">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Pair a viewer"/>
      <TextBlock Text="Scan this short-lived QR code from the SonicRelay viewer, or enter the pairing code manually."
                 TextWrapping="Wrap" Opacity="0.7"/>

      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="184" Height="184" Background="White" CornerRadius="8" Padding="8">
          <Image x:Name="QrImage" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Pairing code" Opacity="0.7"/>
          <TextBlock x:Name="PairingCodeText" FontSize="28" FontWeight="SemiBold" Text="—"/>
          <Button x:Name="CopyPairingCodeButton" Content="Copy pairing code"
                  Click="CopyPairingCode_Click" IsEnabled="False" HorizontalAlignment="Left"/>
          <TextBlock Text="Pairing challenge ID" Opacity="0.7" Margin="0,8,0,0"/>
          <TextBlock x:Name="PairingChallengeIdText" Text="—" TextWrapping="Wrap"/>
          <Button x:Name="CopyChallengeIdButton" Content="Copy challenge ID"
                  Click="CopyChallengeId_Click" IsEnabled="False" HorizontalAlignment="Left"/>
          <TextBlock x:Name="PairingExpiryText" Opacity="0.7" Text="Create a pairing code to begin." TextWrapping="Wrap"/>
          <TextBlock Text="Session join code" Opacity="0.7" Margin="0,8,0,0"/>
          <TextBlock x:Name="SessionCodeText" FontSize="20" FontWeight="SemiBold" Text="—"/>
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="RefreshChallengeButton" Content="Create pairing code"
                Click="RefreshChallenge_Click" IsEnabled="False"/>
        <Button x:Name="RefreshPairingsButton" Content="Refresh paired viewers"
                Click="RefreshPairings_Click" IsEnabled="False"/>
        <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"/>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                 TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock FontWeight="SemiBold" Text="Paired viewers"/>
      <StackPanel x:Name="PairingsPanel" Spacing="8">
        <TextBlock Text="No active paired viewers." Opacity="0.7"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
