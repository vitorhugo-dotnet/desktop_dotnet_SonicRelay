<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SonicRelay.Windows.Desktop</RootNamespace>
    <!-- Becomes the executable's FileDescription, the name Task Manager shows. -->
    <AssemblyTitle>SonicRelay Publisher</AssemblyTitle>
    <Description>Capture desktop audio and publish it to SonicRelay viewers.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Embeds the SonicRelay brand icon into the exe so Explorer, the taskbar, Alt-Tab,
         and the Start menu search result show it instead of the default generic icon. -->
    <ApplicationIcon>Assets\sonicrelay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- .ico is embedded into the exe via ApplicationIcon above (a build-time /win32icon
         argument, not an Avalonia asset); the .png is the runtime bitmap for the window
         titlebar and tray icons, loaded through avares://. -->
    <AvaloniaResource Include="Assets\sonicrelay.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <!-- Pin the patched DBus protocol lib: Avalonia.Desktop pulls a transitive
         0.21.2 with advisory GHSA-xrw6-gwf8-vvr9. Linux-only; harmless on Windows. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SonicRelay.Platform.Linux/SonicRelay.Platform.Linux.csproj" />
    <ProjectReference Include="../SonicRelay.Platform.MacOs/SonicRelay.Platform.MacOs.csproj" />
    <ProjectReference Include="../SonicRelay.Windows.ApiClient/SonicRelay.Windows.ApiClient.csproj" />
    <ProjectReference Include="../SonicRelay.Windows.Audio/SonicRelay.Windows.Audio.csproj" />
    <ProjectReference Include="../SonicRelay.Windows.Core/SonicRelay.Windows.Core.csproj" />
    <ProjectReference Include="../SonicRelay.Windows.Presentation/SonicRelay.Windows.Presentation.csproj" />
    <ProjectReference Include="../SonicRelay.Windows.Signaling/SonicRelay.Windows.Signaling.csproj" />
    <ProjectReference Include="../SonicRelay.Windows.WebRtc/SonicRelay.Windows.WebRtc.csproj" />
  </ItemGroup>
</Project>
