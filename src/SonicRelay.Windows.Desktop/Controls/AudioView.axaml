<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SonicRelay.Windows.Desktop.ViewModels"
             xmlns:audio="using:SonicRelay.Windows.Audio"
             x:Class="SonicRelay.Windows.Desktop.Controls.AudioView"
             x:DataType="vm:AudioPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">

      <TextBlock Classes="metric-label"
                 IsVisible="{Binding !IsConnected}"
                 Text="Sign in to a backend to choose the audio output." />

      <Border Classes="card" IsVisible="{Binding IsConnected}">
        <StackPanel Spacing="12">
          <TextBlock Classes="card-title" Text="Capture source" />
          <TextBlock Classes="metric-label" Text="Which system output endpoint to capture; applies to the next capture start." />
          <ComboBox ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Audio output device">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="audio:AudioOutputDevice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Border>

      <!-- Two-way audio (dotnet_SonicRelay#22). Hidden entirely when this build has no
           microphone or playback device: a control that could only half work is worse than
           no control at all. -->
      <Border Classes="card" IsVisible="{Binding SupportsTwoWayAudio}">
        <StackPanel Spacing="12">
          <TextBlock Classes="card-title" Text="Two-way audio" />
          <TextBlock Classes="metric-label"
                     Text="A two-way session publishes this device's microphone instead of the system output, and plays what the other participants send." />

          <CheckBox IsChecked="{Binding StartNextSessionAsTwoWay}"
                    IsVisible="{Binding !IsTwoWaySession}"
                    Content="Open the next session for conversation"
                    AutomationProperties.Name="Open the next session for conversation" />
          <TextBlock Classes="metric-label"
                     IsVisible="{Binding !IsTwoWaySession}"
                     Text="A session's mode is fixed when it is created, so this applies to the next one." />

          <StackPanel Spacing="12" IsVisible="{Binding IsTwoWaySession}">
            <TextBlock Classes="metric-label" Text="{Binding PlaybackStatus}" />
            <Button Command="{Binding ToggleMuteCommand}"
                    Content="{Binding MuteActionLabel}"
                    HorizontalAlignment="Left" />

            <ItemsControl ItemsSource="{Binding Participants}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TwoWayParticipantViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Classes="metric-label" Text="{Binding Status}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            IsVisible="{Binding ShowsPermissionControl}"
                            Command="{Binding TogglePermissionCommand}"
                            Content="{Binding PermissionActionLabel}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
