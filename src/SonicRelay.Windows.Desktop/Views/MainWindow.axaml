<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SonicRelay.Windows.Desktop.Controls"
        xmlns:vm="using:SonicRelay.Windows.Desktop.ViewModels"
        x:Class="SonicRelay.Windows.Desktop.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SonicRelay Publisher"
        Width="1200" Height="820"
        MinWidth="880" MinHeight="620"
        Background="{DynamicResource Sonic.AppBackgroundBrush}">

  <Panel>
    <Grid ColumnDefinitions="Auto,*">
    <!-- Left navigation rail -->
    <controls:SidebarNavigation Grid.Column="0" Width="232" />

    <!-- Main area -->
    <DockPanel Grid.Column="1" LastChildFill="True">

      <!-- Top bar (shared across pages) -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource Sonic.SidebarBackgroundBrush}"
              BorderBrush="{DynamicResource Sonic.CardBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="24,16">
        <!-- ColumnSpacing plus trimmed title/subtitle keep the star column from painting
             under the status pill when the window gets narrow. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" FontSize="{StaticResource Sonic.FontSizeHeadline}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Sonic.TextPrimaryBrush}" />
            <TextBlock Text="{Binding PageSubtitle}" Classes="metric-label"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <controls:AccountStatusHeader Grid.Column="1"
                                        DataContext="{Binding Shell}" />
          <!-- Revokes this device's pairings, then forgets its identity and returns to the
               pairing surface (issue #26 follow-up) — the recovery path for a stale/rejected
               device credential that would otherwise never show a pairing code again without
               an app restart, and that used to leave every paired phone's pairing silently
               dead by re-bootstrapping a new DeviceId. Two-click confirm: first click arms
               (UnpairButtonLabel switches to the confirm wording), second click acts. -->
          <Button Grid.Column="2" Margin="16,0,0,0" Classes="ghost"
                  Content="{Binding UnpairButtonLabel}" Command="{Binding UnpairCommand}" />
        </Grid>
      </Border>

      <!-- Page content, swapped by the sidebar selection -->
      <Panel>
        <!-- Pairing (issue #26 follow-up, refined by Task 3's device-identity gate: Pairing and
             Settings stay reachable while every other destination is locked until this device
             bootstraps an identity — fixing the old full-shell gate, which hid Settings too, so
             a bad backend URL left no way back in, and hid the pairing surface at exactly the
             moment bootstrap gave it real content to show). Renders its own "device identity
             unavailable" placeholder when Pairing is null. DataContext is the Pairing view
             model, so — same as Session/Diagnostics/Audio/Settings below — IsVisible must read
             IsPairing back off the root DataContext via ElementName rather than an implicit
             binding: with compiled bindings, an implicit `{Binding IsPairing}` on this same
             element resolves against this element's own (just-overridden) DataContext type,
             PairingViewModel, which has no IsPairing member, and fails to build (AVLN2000). -->
        <controls:PairingView DataContext="{Binding Pairing}"
                              IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsPairing, ElementName=RootWindow}" />

        <!-- Dashboard. The technical console scrolls with the cards (it used to be docked to
             the bottom of the page, where it painted over the card grid at narrow sizes). -->
        <DockPanel IsVisible="{Binding IsDashboard}" LastChildFill="True">
          <Border DockPanel.Dock="Top" Padding="24,16,24,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Create session" Command="{Binding CreateSessionCommand}" />
              <Button Content="Start audio" Command="{Binding StartAudioCommand}" />
              <Button Content="Stop audio" Command="{Binding StopAudioCommand}" />
              <Button Content="End session" Command="{Binding EndSessionCommand}" />
              <Button Content="Retry" Command="{Binding RetryCommand}" />
            </StackPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="16,16,16,0">
              <controls:SessionCodeCard Width="440" Margin="8" DataContext="{Binding Shell}" />
              <controls:AudioLevelMonitor Width="440" Margin="8"
                                          Level="{Binding Shell.AudioLevelFraction}"
                                          PeakText="{Binding Shell.AudioPeakDbText}"
                                          IsActive="{Binding Shell.IsCapturing}" />
              <controls:InfrastructureStatusCard Width="360" Margin="8" DataContext="{Binding Shell}" />
              <Border Classes="card" Width="360" Margin="8">
                <StackPanel Spacing="14">
                  <TextBlock Classes="card-title" Text="Stream Quality" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="card-elevated">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="metric-label" Text="Latency" />
                        <TextBlock Classes="mono metric-value" Text="{Binding Shell.LatencyText}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card-elevated">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="metric-label" Text="Jitter" />
                        <TextBlock Classes="mono metric-value" Text="{Binding Shell.JitterText}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card-elevated">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="metric-label" Text="Loss" />
                        <TextBlock Classes="mono metric-value" Text="{Binding Shell.PacketLossText}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <controls:BandwidthGauge Width="360" Margin="8" DataContext="{Binding Shell}" />
            </WrapPanel>
            <controls:TechnicalConsole MaxHeight="260"
                                       Margin="24,8,24,20"
                                       DataContext="{Binding Shell}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- Diagnostics -->
        <controls:DiagnosticsView
            IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsDiagnostics, ElementName=RootWindow}" />

        <!-- Audio -->
        <controls:AudioView DataContext="{Binding Audio}"
                            IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsAudio, ElementName=RootWindow}" />

        <!-- Settings -->
        <controls:SettingsView DataContext="{Binding Settings}"
                               IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsSettings, ElementName=RootWindow}" />
      </Panel>
    </DockPanel>
    </Grid>
  </Panel>
</Window>
